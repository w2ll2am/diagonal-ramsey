/-- Read a string `"a/b"` (decimal integer `a`, decimal natural `b`) as the rational `a / b`; any other
string reads as `0` (all data strings have this form, as the generator checks). -/
def parseRat (s : String) : ℚ :=
  match s.splitOn "/" with
  | [a, b] => ((a.toInt?.getD 0 : ℤ) : ℚ) / ((b.toNat?.getD 1 : ℕ) : ℚ)
  | _ => 0

/-- Read entry `i` of a data list as a real number (`0` out of range; only indices `0..2279` are used). -/
noncomputable def luWangDatum (L : List String) (i : ℕ) : ℝ :=
  ((parseRat (L.getD i "0/1") : ℚ) : ℝ)

/-- The knot `t_i`. -/
noncomputable def luWangKnot (i : ℕ) : ℝ := luWangDatum luWangKnotData i

/-- The index of the piece used at `t`: the number of knots `t_1, ..., t_2278` strictly below `t`. For
`0 ≤ t ≤ 1` this is an `i ≤ 2278` with `t_i ≤ t ≤ t_(i+1)`. -/
noncomputable def luWangPiece (t : ℝ) : ℕ := by
  classical
  exact ((List.range 2278).filter (fun j => luWangKnot (j + 1) < t)).length

/-- The cubic Hermite interpolant on `[a, b]` with values `va, vb` and derivatives `da, db`, evaluated at `t`. -/
noncomputable def hermiteCubic (a b va vb da db t : ℝ) : ℝ :=
  let h := b - a
  let s := t - a
  va + da * s + ((3 * (vb - va) / h - 2 * da - db) / h) * s ^ 2 + ((da + db - 2 * (vb - va) / h) / h ^ 2) * s ^ 3

/-- The correction polynomial `P_i(t)` on the piece containing `t`. -/
noncomputable def luWangCorrection (t : ℝ) : ℝ :=
  let i := luWangPiece t
  hermiteCubic (luWangKnot i) (luWangKnot (i + 1)) (luWangDatum luWangValueData i)
    (luWangDatum luWangValueData (i + 1)) (luWangDatum luWangDerivData i) (luWangDatum luWangDerivData (i + 1)) t

/-- The Lu--Wang source `F : [0,1] → ℝ`,
`F(t) = (1+t) log(1+t) - t log t + t exp(-t) P(t)`. Only its values on `[0,1]` are meaningful. -/
noncomputable def luWangSource (t : ℝ) : ℝ :=
  (1 + t) * Real.log (1 + t) - t * Real.log t + t * Real.exp (-t) * luWangCorrection t

/-- The symmetric homogeneous extension `max(a,b) F(min(a,b)/max(a,b))`, as `RamseyCurrent.symmetricProfile`. -/
noncomputable def symmetricProfile (F : ℝ → ℝ) (a b : ℝ) : ℝ :=
  max a b * F (min a b / max a b)

end DiagRamsey
